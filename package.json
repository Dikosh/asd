{
  "name": "jolda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jolda — биржа грузов и транспорта с GPS-рейсами и проверкой компаний",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "DEMO_MODE=1 concurrently -n api,web -c blue,red \"node --watch server/index.js\" \"vite\"",
    "demo": "DEMO_MODE=1 node server/index.js",
    "build": "tsc --noEmit -p web && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "i18n": "node scripts/i18n-check.cjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
